{
  "name": "securitywatch",
  "version": "1.0.0",
  "description": "Runtime security engine for Node.js apps — SQL injection, XSS, brute force, rate limiting, and IP reputation scoring in one middleware.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "security",
    "middleware",
    "express",
    "sql-injection",
    "xss",
    "rate-limit",
    "brute-force",
    "waf",
    "runtime-security",
    "ip-reputation"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2"
  }
}
